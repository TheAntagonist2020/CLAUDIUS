# --- CLAUDIUS configuration (copy to .env and fill in) ---

# Server
PORT=3001
HOST=0.0.0.0

# TMDB API — required for enrichment (posters, credits, streaming providers)
# Create a free account at https://www.themoviedb.org/, then generate a v3 key.
TMDB_API_KEY=

# MDBList API — optional, used for streaming availability + watchlist push
# Sign up at https://mdblist.com/ to get a key. Leave blank to disable.
MDBLIST_API_KEY=
MDBLIST_QUEUE_LIST_ID=

# Data directory — where import CSVs live.
# Defaults to <repo>/data. Each specific path can also be overridden below.
# DATA_DIR=/absolute/path/to/data

# Import file overrides (all optional — defaults to $DATA_DIR/<name>)
# WATCHED_DATA_PATH=
# SUPER_LIST_PATH=
# GAP_LIST_PATH=
# GAP_MASTER_PATH=
# XLSX_DATA_PATH=
