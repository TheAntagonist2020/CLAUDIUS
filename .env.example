# --- CLAUDIUS configuration (copy to .env and fill in) ---

# Server
PORT=3001

# TMDB API — required for enrichment (posters, credits, streaming)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Anthropic API — required for the /chat feature
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Trakt API — required for Trakt sync (device-code OAuth)
# https://trakt.tv/oauth/applications → create app, get client id/secret
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# How often (hours) to auto-run Trakt sync in the background (0 to disable)
TRAKT_SYNC_INTERVAL_HOURS=6

# MDBList API — optional. Enables streaming lookup + watchlist push.
MDBLIST_API_KEY=

# App-level password gate (very light auth). Change for anything internet-facing.
APP_PASSWORD=claudius
JWT_SECRET=change-me-in-prod

# Postgres (optional — if you want to migrate from SQLite later)
# DATABASE_URL=
