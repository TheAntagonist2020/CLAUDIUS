# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── TMDb (required for enrichment) ────────────────────────────────────────────
# Get a free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# ── MDBList (required for streaming info & Stremio integration) ────────────────
# Get your key at https://mdblist.com/preferences
MDBLIST_API_KEY=your_mdblist_api_key_here
# The numeric ID of the MDBList list to use as your Stremio queue
MDBLIST_QUEUE_LIST_ID=

# ── Data files ────────────────────────────────────────────────────────────────
# Root folder that contains all your CSV/XLSX data files.
# Defaults to ~/claudius-data if not set.
# Unix:    DATA_DIR=/home/yourname/claudius-data
# Windows: DATA_DIR=C:\Users\YourName\claudius-data
DATA_DIR=/path/to/your/claudius-data

# Individual file paths (override if your files live elsewhere).
# If omitted, CLAUDIUS looks for these names inside DATA_DIR.
WATCHED_DATA_PATH=
SUPER_LIST_PATH=
WATCH_HISTORY_PATH=
REVIEW_TRACKER_PATH=
GAP_LIST_PATH=
GAP_MASTER_PATH=
XLSX_DATA_PATH=

# ── Streaming staleness ────────────────────────────────────────────────────────
# Number of days before cached streaming availability is considered stale.
# Defaults to 30. Run "Refresh Streaming" in Admin to update stale records.
STREAMING_STALE_DAYS=30
